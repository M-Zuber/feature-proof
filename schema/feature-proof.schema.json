{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oss.example.org/feature-proof.schema.json",
  "title": "FeatureProof parity file",
  "type": "object",
  "required": [ "schema", "project", "areas", "checks", "runs" ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "feature-proof/v1" },
    "project": {
      "type": "object",
      "required": [ "name", "targetSystem", "sourceSystems" ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "targetSystem": { "type": "string", "minLength": 1 },
        "sourceSystems": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "description": { "type": "string" }
      }
    },
    "areas": {
      "type": "array",
      "items": { "$ref": "#/$defs/area" }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "runs": {
      "type": "array",
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "$defs": {
    "area": {
      "type": "object",
      "required": [ "id", "name" ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "check": {
      "type": "object",
      "required": [ "id", "area", "title", "sourceSystem", "priority", "description", "steps", "expected" ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "area": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "sourceSystem": { "type": "string", "minLength": 1 },
        "priority": { "enum": [ "must", "should", "could" ] },
        "description": { "type": "string" },
        "steps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "expected": {
          "type": "array",
          "items": { "type": "string" }
        },
        "agentHints": { "$ref": "#/$defs/agentHints" }
      }
    },
    "agentHints": {
      "type": "object",
      "properties": {
        "testType": { "type": "string" },
        "selectors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dataRequirements": {
          "type": "array",
          "items": { "type": "string" }
        },
        "risks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "run": {
      "type": "object",
      "required": [ "id", "startedAt", "tester", "targetVersion", "environment", "results" ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": [ "string", "null" ], "format": "date-time" },
        "tester": { "type": "string" },
        "targetVersion": { "type": "string" },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/result" }
        }
      }
    },
    "result": {
      "type": "object",
      "required": [ "checkId", "status", "recordedAt" ],
      "properties": {
        "checkId": { "type": "string" },
        "status": {
          "enum": [ "untested", "pass", "partial", "fail", "blocked", "notApplicable", "needsReview" ]
        },
        "notes": { "type": [ "string", "null" ] },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "recordedAt": { "type": "string", "format": "date-time" }
      }
    },
    "evidence": {
      "type": "object",
      "required": [ "type", "path" ],
      "properties": {
        "type": { "type": "string" },
        "path": { "type": "string" },
        "caption": { "type": [ "string", "null" ] }
      }
    }
  }
}
