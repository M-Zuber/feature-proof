{
  "$schema": "../schema/feature-proof.schema.json",
  "schema": "feature-proof/v1",
  "project": {
    "name": "All-in-One CRM Feature Parity",
    "targetSystem": "New All-in-One CRM",
    "sourceSystems": [
      "Legacy CRM",
      "Donations Portal",
      "Events System"
    ],
    "description": "Sample parity project for validating critical workflows from existing systems."
  },
  "areas": [
    {
      "id": "donor-management",
      "name": "Donor Management",
      "description": "Find, inspect, and maintain donor/account records."
    },
    {
      "id": "gift-processing",
      "name": "Gift Processing",
      "description": "Record and reconcile contributions."
    },
    {
      "id": "events",
      "name": "Events",
      "description": "Event registration and attendance workflows."
    }
  ],
  "checks": [
    {
      "id": "donor-search-basic",
      "area": "donor-management",
      "title": "Search donors by name",
      "sourceSystem": "Legacy CRM",
      "priority": "must",
      "description": "A user can find an existing donor by first name, last name, or organization name.",
      "steps": [
        "Open donor search.",
        "Search for an existing donor by last name.",
        "Open the matching donor record."
      ],
      "expected": [
        "Matching donor records are shown.",
        "Results include donor name, account id, and primary contact details.",
        "The selected donor profile opens without data loss."
      ],
      "agentHints": {
        "testType": "ui",
        "selectors": [
          "[data-testid='donor-search-input']",
          "[data-testid='donor-result-row']"
        ],
        "dataRequirements": [
          "An existing donor with a known last name."
        ],
        "risks": [
          "Duplicate names may require account id verification."
        ]
      }
    },
    {
      "id": "donor-contact-update",
      "area": "donor-management",
      "title": "Update donor contact details",
      "sourceSystem": "Legacy CRM",
      "priority": "must",
      "description": "A user can update phone and email fields while preserving audit context.",
      "steps": [
        "Open a donor profile.",
        "Edit the primary email and phone number.",
        "Save the profile.",
        "Refresh and reopen the donor profile."
      ],
      "expected": [
        "The updated values persist.",
        "The change appears in the donor activity or audit history."
      ],
      "agentHints": {
        "testType": "ui",
        "dataRequirements": [
          "A donor record safe to edit in the test environment."
        ],
        "risks": [
          "Shared test data may be modified by another tester."
        ]
      }
    },
    {
      "id": "gift-one-time-card",
      "area": "gift-processing",
      "title": "Record one-time card donation",
      "sourceSystem": "Donations Portal",
      "priority": "must",
      "description": "A user can record a one-time credit card donation and associate it to the correct donor.",
      "steps": [
        "Start a new gift entry.",
        "Select an existing donor.",
        "Enter a one-time card donation amount.",
        "Submit the gift."
      ],
      "expected": [
        "The gift is created with the correct amount and payment method.",
        "The gift is visible on the donor record.",
        "The transaction receives a unique receipt or confirmation id."
      ],
      "agentHints": {
        "testType": "ui-plus-data",
        "dataRequirements": [
          "A test payment token or gateway sandbox card."
        ],
        "risks": [
          "Payment gateway sandbox outages can block the check."
        ]
      }
    },
    {
      "id": "event-registration-list",
      "area": "events",
      "title": "View event registration list",
      "sourceSystem": "Events System",
      "priority": "should",
      "description": "A user can open an event and inspect current registrations.",
      "steps": [
        "Open the events module.",
        "Select an active event.",
        "Open the registration list."
      ],
      "expected": [
        "Registrants are listed with name, ticket type, payment state, and attendance state.",
        "The list can be filtered or searched."
      ],
      "agentHints": {
        "testType": "ui",
        "dataRequirements": [
          "An active event with at least two registrations."
        ]
      }
    }
  ],
  "runs": [
    {
      "id": "run-20260602-acceptance-seed",
      "startedAt": "2026-06-02T09:00:00+03:00",
      "completedAt": "2026-06-02T09:20:00+03:00",
      "tester": "sample.user",
      "targetVersion": "crm-preview-0.1",
      "environment": {
        "browser": "Edge",
        "url": "https://crm-dev.example.local"
      },
      "results": [
        {
          "checkId": "donor-search-basic",
          "status": "pass",
          "notes": "Search returned the expected donor and profile opened.",
          "evidence": [
            {
              "type": "screenshot",
              "path": "evidence/run-20260602-acceptance-seed/donor-search-basic.png",
              "caption": "Donor search result list."
            }
          ],
          "recordedAt": "2026-06-02T09:08:00+03:00"
        },
        {
          "checkId": "gift-one-time-card",
          "status": "blocked",
          "notes": "Gateway sandbox credentials were not available.",
          "evidence": [],
          "recordedAt": "2026-06-02T09:18:00+03:00"
        }
      ]
    }
  ]
}
